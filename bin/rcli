#!/usr/bin/env bash
# rcli - redis-cli wrapper for multiple Redis/Sentinel instances on one host.
#
# Instance definitions are taken from /etc/redis/*.conf (see EXCLUDE_CONFS).
# Port, password and bind address are read from the chosen instance's config.
#
# Usage:
#   rcli [list]                    # table of all instances (columns below)
#   rcli names                     # instance names only (used by completion)
#   rcli status <instance>         # STATE only; exit 0 when "ok" (for wait loops)
#   rcli shards <instance>         # "cluster nodes" grouped by shard, IPs resolved to hostnames
#   rcli <instance> [args...]      # run redis-cli; <instance> = config name without .conf
#   rcli <port> [args...]          # or a port number
#   rcli --help                    # this text
#
# Columns of "rcli list":
#   INSTANCE   config file name without .conf; rows are ordered by PORT
#   PORT       "port" directive of the config
#   TYPE       sentinel         = config has "sentinel monitor"
#              cluster          = cluster-enabled yes
#              sentinel-managed = master monitored by a sentinel config on this
#                                 host, or a replica of such a master
#              standalone       = none of the above
#   ROLE       master | slave | sentinel, as reported by INFO. A trailing "?"
#              (master?, slave?) means STATE is not "ok": the role comes from
#              the config/nodes.conf and a failover meanwhile may change it.
#              "?" alone = instance unreachable.
#   STATE      ok         serving requests
#              loading    loading RDB/AOF into memory (N% on Redis 7+); the
#                         instance answers INFO but every other command gets
#                         LOADING
#              sync       replica receiving the RDB from its master: N% when
#                         the master sends a file (repl-diskless-sync no),
#                         bytes received so far when it streams (repl-diskless-
#                         sync yes, total size unknown), plain "sync" before
#                         the transfer starts (master doing bgsave / diskless
#                         sync delay)
#              link-down  replica not connected to its master (master_link_
#                         status:down, no sync in progress), e.g. right after
#                         start or while the master is unreachable
#              down       no reply within $RCLI_TIMEOUT seconds (default 3):
#                         not running, wrong port, or too busy to answer INFO
#              <ERROR>    first word of an error reply, e.g. NOAUTH (password
#                         in the config does not match)
#   AUTH       yes = config has requirepass (it is used automatically)
#   MAXMEM     maxmemory from INFO ("unlimited" when 0); from the config when
#              the instance is down
#   USED       used_memory_human from INFO
#   MAIN@IOTHREADS
#              CPU numbers (from ps): the CPU the main thread (redis-server)
#              was last seen on, then after "@" one CPU per running io-thread
#              (io_thd_N), e.g. 12@13,14,15; no "@" part = single-threaded I/O
#   BIND       "bind" directive of the config; "-" = not set (all interfaces)
#   MASTERS    sentinel only: "<name>=<host>:<port>[/<flags>]" for each
#              monitored master, host resolved via /etc/hosts or reverse DNS;
#              flags are shown only when not plain "master" (s_down, o_down...)
#
# With no redis-cli args:
#   stdout is a terminal            -> interactive console
#   stdout is a pipe/file, stdin tty -> runs "info" (so "rcli x | grep ..." works)
#   stdin is a pipe                 -> commands are read from stdin (redis-cli default)
#
# Environment:
#   RCLI_CONF_DIR  directory with the instance configs (default /etc/redis)
#   RCLI_TIMEOUT   seconds to wait for a reply in list/status/shards (default 3)
#
# Examples:
#   rcli cache
#   rcli sentinel-cache sentinel masters
#   rcli 6380 info replication
#   until rcli status cache; do sleep 1; done

set -euo pipefail

CONF_DIR="${RCLI_CONF_DIR:-/etc/redis}"
EXCLUDE_CONFS=(
    "redis.conf"
)
QUERY_TIMEOUT="${RCLI_TIMEOUT:-3}"

is_excluded() {
    local name="$1" excluded
    for excluded in "${EXCLUDE_CONFS[@]}"; do
        [[ "$name" == "$excluded" ]] && return 0
    done
    return 1
}

list_confs() {  # instance configs ordered by port; ones without a port last
    local conf port
    for conf in "$CONF_DIR"/*.conf; do
        [[ -f "$conf" ]] || continue
        is_excluded "$(basename "$conf")" && continue
        port=$(conf_get "$conf" port)
        printf '%s\t%s\n' "${port:-999999}" "$conf"
    done | sort -n -k1,1 | cut -f2-
}

conf_get() {  # conf_get <conf> <directive> -> first value of the directive
    awk -v key="$2" '$1==key{print $2; exit}' "$1" | tr -d '"'
}

conf_host() {
    local host
    host=$(conf_get "$1" bind)
    host="${host:-127.0.0.1}"
    [[ "$host" == "0.0.0.0" || "$host" == "*" ]] && host="127.0.0.1"
    echo "$host"
}

# Ports of masters/replicas monitored by any sentinel config on this host.
# Sentinel rewrites its config with discovered replicas as "known-replica".
sentinel_managed_ports() {
    awk '$1=="sentinel" && ($2=="monitor" || $2=="known-replica" || $2=="known-slave") {print $5}' \
        "$CONF_DIR"/*.conf 2>/dev/null | sort -u
}

conf_type() {  # conf_type <conf> <managed_ports> <info_text>
    local conf="$1" managed="$2" info="$3" port
    if awk '$1=="sentinel" && $2=="monitor"{found=1} END{exit !found}' "$conf"; then
        echo "sentinel"; return
    fi
    if [[ "$(conf_get "$conf" cluster-enabled)" == "yes" ]]; then
        echo "cluster"; return
    fi
    # A replica is managed if its *master* is monitored by a sentinel (ports may
    # differ between hosts); a master is managed if one of its own ports is
    # monitored. Sentinel may address the instance via its TLS port, so both
    # "port" and "tls-port" are checked.
    if [[ "$(info_field "$info" role)" == "slave" ]]; then
        port=$(info_field "$info" master_port)
    else
        port=$(printf '%s\n' "$(conf_get "$conf" port)" "$(conf_get "$conf" tls-port)")
    fi
    if [[ -n "$port" ]] && grep -qxF -f <(grep -v '^$' <<<"$port") <<<"$managed"; then
        echo "sentinel-managed"
    else
        echo "standalone"
    fi
}

run_cli() {  # run_cli <conf> [redis-cli args...]
    local conf="$1"; shift
    local host port pass
    host=$(conf_host "$conf")
    port=$(conf_get "$conf" port)
    pass=$(conf_get "$conf" requirepass)
    if [[ -n "$pass" ]]; then
        REDISCLI_AUTH="$pass" redis-cli -h "$host" -p "$port" "$@"
    else
        redis-cli -h "$host" -p "$port" "$@"
    fi
}

live_query() {  # live_query <conf> [redis-cli args...] -> output, or empty if unreachable
    timeout "$QUERY_TIMEOUT" bash -c "$(declare -f conf_get conf_host run_cli); run_cli \"\$@\" 2>/dev/null" _ "$@" \
        | tr -d '\r' || true
}

live_info() {  # live_info <conf> -> INFO output, or empty if unreachable
    live_query "$1" info
}

# Resolve an IP to a hostname: /etc/hosts first, then reverse DNS (getent),
# otherwise the IP itself. Results are cached per run.
declare -A HOST_CACHE
resolve_host() {  # resolve_host <ip>
    local ip="$1" name=""
    if [[ -n "${HOST_CACHE[$ip]+x}" ]]; then
        echo "${HOST_CACHE[$ip]}"; return
    fi
    name=$(awk -v ip="$ip" '!/^[[:space:]]*#/ && $1 == ip { print $2; exit }' /etc/hosts 2>/dev/null)
    if [[ -z "$name" ]]; then
        name=$(timeout "$QUERY_TIMEOUT" getent hosts "$ip" 2>/dev/null | awk '{ print $2; exit }' || true)
    fi
    HOST_CACHE[$ip]="${name:-$ip}"
    echo "${HOST_CACHE[$ip]}"
}

# Masters monitored by a sentinel: "name=host:port[/flags],..." (host is the
# resolved IP, see resolve_host; flags shown only when not plain "master",
# e.g. s_down/o_down). Non-tty redis-cli prints the reply as flat key/value
# lines, so odd lines are keys and even lines values.
sentinel_masters() {  # sentinel_masters <conf>
    local name ip port flags out=""
    while read -r name ip port flags; do
        [[ -n "$name" ]] || continue
        out+="${out:+,}$name=$(resolve_host "$ip"):$port"
        [[ "$flags" == "master" ]] || out+="/$flags"
    done < <(live_query "$1" sentinel masters | awk '
        NR % 2 == 1 { key = $0; next }
        key == "name"  { name = $0 }
        key == "ip"    { ip = $0 }
        key == "port"  { port = $0 }
        key == "flags" { print name, ip, port, $0 }')
    echo "$out"
}

info_field() {  # info_field <info_text> <key>
    awk -F: -v key="$2" '$1==key{print $2; exit}' <<<"$1"
}

human_bytes() {  # human_bytes <bytes> -> e.g. 1.3G, 512M, 900K
    awk -v b="$1" 'BEGIN {
        split("B K M G T", unit, " "); i = 1
        while (b >= 1024 && i < 5) { b /= 1024; i++ }
        printf (i == 1 ? "%d%s" : "%.1f%s"), b, unit[i] }'
}

# Readiness of an instance from its INFO output (see STATE in the header).
# An unreachable instance gives empty INFO; an error reply (NOAUTH, ...) has no
# redis_version line and its first word is used as the state.
instance_state() {  # instance_state <info_text> <type>
    local info="$1" type="$2" perc
    [[ -n "$info" ]] || { echo "down"; return; }
    if ! grep -q '^redis_version:' <<<"$info"; then
        awk 'NR==1 { print $1; exit }' <<<"$info"
        return
    fi
    if [[ "$(info_field "$info" loading)" == "1" ]]; then
        perc=$(info_field "$info" loading_loaded_perc)  # Redis >= 7.0 only
        echo "loading${perc:+ ${perc%.*}%}"
        return
    fi
    if [[ "$type" != "sentinel" && "$(info_field "$info" role)" == "slave" ]]; then
        if [[ "$(info_field "$info" master_sync_in_progress)" == "1" ]]; then
            # Percent only when the RDB size is known. With diskless sync on the
            # master (default since 7.0) total is -1, so show bytes received
            # instead: a growing number means the transfer is running.
            local total read
            total=$(info_field "$info" master_sync_total_bytes)
            read=$(info_field "$info" master_sync_read_bytes)
            if [[ "$total" =~ ^[1-9] ]]; then
                perc=$(info_field "$info" master_sync_perc)  # Redis >= 7.0 only
                echo "sync${perc:+ ${perc%.*}%}"
            elif [[ "$read" =~ ^[1-9] ]]; then
                echo "sync $(human_bytes "$read")"
            else
                echo "sync"
            fi
            return
        fi
        if [[ "$(info_field "$info" master_link_status)" != "up" ]]; then
            echo "link-down"; return
        fi
    fi
    echo "ok"
}

# CPUs the server threads were last seen on (psr): "<main>@<io,io,...>" where
# <main> is the main thread (tid == pid) and the rest are the I/O threads,
# which Redis names "io_thd_N". Without I/O threads only <main> is printed.
thread_cpus() {  # thread_cpus <pid>
    local out
    [[ -n "$1" ]] || { echo "?"; return; }
    out=$(ps -T -p "$1" -o tid=,psr=,comm= 2>/dev/null \
        | awk -v pid="$1" '
            $1 == pid          { main = $2 }
            $3 ~ /^io_thd_/    { io = io (io ? "," : "") $2 }
            END { if (main != "") print main (io ? "@" io : "") }')
    echo "${out:-?}"
}

cmd_list() {
    local managed conf name port pass auth type info role state maxmem used cpus masters bind
    managed=$(sentinel_managed_ports)
    {
    printf '%s\t' "INSTANCE" "PORT" "TYPE" "ROLE" "STATE" "AUTH" "MAXMEM" "USED" "MAIN@IOTHREADS" "BIND"; echo "MASTERS"
    while read -r conf; do
        name=$(basename "$conf" .conf)
        port=$(conf_get "$conf" port)
        pass=$(conf_get "$conf" requirepass)
        [[ -n "$pass" ]] && auth="yes" || auth="no"
        info=$(live_info "$conf")
        type=$(conf_type "$conf" "$managed" "$info")
        state=$(instance_state "$info" "$type")
        cpus="-"
        masters="-"

        if [[ -n "$info" ]]; then
            role=$(info_field "$info" role)
            used=$(info_field "$info" used_memory_human)
            maxmem=$(info_field "$info" maxmemory_human)
            [[ "$maxmem" == "0B" ]] && maxmem="unlimited"
            if [[ "$type" == "sentinel" ]]; then
                role="sentinel"; maxmem="-"; used="-"
                masters=$(sentinel_masters "$conf")
                masters="${masters:-?}"
            else
                cpus=$(thread_cpus "$(info_field "$info" process_id)")
                # Until the instance serves requests its role is only what the
                # config/nodes.conf says; a failover meanwhile may change it.
                [[ "$state" == "ok" || -z "$role" ]] || role+="?"
            fi
        else
            role="?"
            used="-"
            maxmem=$(conf_get "$conf" maxmemory)
            maxmem="${maxmem:-unlimited}"
            [[ "$type" == "sentinel" ]] && maxmem="-"
        fi

        bind=$(conf_get "$conf" bind)
        printf '%s\t' "$name" "${port:-?}" "$type" "${role:-?}" "$state" "$auth" "${maxmem:-?}" "${used:-?}" "$cpus" \
            "${bind:--}"; echo "$masters"
    done < <(list_confs)
    } | align_columns
}

# Print tab-separated rows as a left-aligned table, each column as wide as its
# longest value (the last column is not padded).
align_columns() {
    awk -F'\t' '
        { rows[NR] = $0; if (NF > nf) nf = NF
          for (i = 1; i <= NF; i++) if (length($i) > w[i]) w[i] = length($i) }
        END {
            for (r = 1; r <= NR; r++) {
                split(rows[r], f, "\t"); line = ""
                for (i = 1; i <= nf; i++)
                    line = line (i < nf ? sprintf("%-" w[i] "s  ", f[i]) : f[i])
                print line
            }
        }'
}

# "cluster nodes" grouped by shard: each master (ordered by its first slot)
# followed by its replicas. IPs are resolved like in sentinel_masters. FLAGS
# shows everything but the role (myself, fail?, fail, nofailover, ...) plus
# the link state when it is not "connected".
cmd_shards() {  # cmd_shards <conf>
    local nodes id addr flags master link slots ip port r shard=0
    local -A n_addr n_flags n_master n_link n_slots
    local -a masters replicas
    nodes=$(live_query "$1" cluster nodes)
    [[ -n "$nodes" ]] || { echo "rcli: no reply from instance" >&2; return 1; }
    if ! awk 'NR==1 { exit !(NF >= 8) }' <<<"$nodes"; then
        echo "rcli: unexpected reply: $nodes" >&2   # e.g. ERR cluster support disabled
        return 1
    fi

    while read -r id addr flags master _ _ _ link slots; do
        [[ -n "$id" ]] || continue
        ip="${addr%%:*}"; port="${addr#*:}"; port="${port%%@*}"
        n_addr[$id]="$(resolve_host "$ip"):$port"
        # role is derived from the master column; keep the remaining flags
        n_flags[$id]=$(awk -F, '{ for (i = 1; i <= NF; i++) if ($i != "master" && $i != "slave")
                                      out = out (out ? "," : "") $i } END { print out }' <<<"$flags")
        n_master[$id]="$master"
        n_link[$id]="$link"
        # drop migrating/importing entries like [123->-<id>], join ranges with ","
        n_slots[$id]=$(sed 's/\[[^]]*\]//g' <<<"$slots" | xargs | tr ' ' ',')
        if [[ "$master" == "-" ]]; then
            masters+=("$id")
        else
            replicas+=("$id")
        fi
    done <<<"$nodes"

    node_row() {  # node_row <shard> <slots> <role> <id>
        local extra="${n_flags[$4]}"
        [[ "${n_link[$4]}" == "connected" ]] || extra+="${extra:+,}${n_link[$4]}"
        printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "${n_addr[$4]}" "${4:0:8}" "${extra:--}"
    }

    {
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "SHARD" "SLOTS" "ROLE" "NODE" "ID" "FLAGS"
    # masters ordered by first slot; slotless masters last
    while read -r _ id; do
        shard=$((shard + 1))
        node_row "$shard" "${n_slots[$id]:--}" "master" "$id"
        for r in $(for r in ${replicas[@]+"${replicas[@]}"}; do
                       [[ "${n_master[$r]}" == "$id" ]] && echo "${n_addr[$r]} $r"
                   done | sort | awk '{ print $2 }'); do
            node_row "" "" "replica" "$r"
        done
    done < <(for id in ${masters[@]+"${masters[@]}"}; do
                 slots="${n_slots[$id]}"
                 [[ -n "$slots" ]] && echo "${slots%%[-,]*} $id" || echo "99999 $id"
             done | sort -n)
    # replicas whose master is not in the list (should not happen)
    for r in ${replicas[@]+"${replicas[@]}"}; do
        grep -qx "${n_master[$r]}" < <(printf '%s\n' ${masters[@]+"${masters[@]}"}) \
            || node_row "?" "" "replica" "$r"
    done
    } | align_columns
}

cmd_status() {  # cmd_status <conf> -> prints STATE; exit 0 only when "ok"
    local conf="$1" info state
    info=$(live_info "$conf")
    state=$(instance_state "$info" "$(conf_type "$conf" "$(sentinel_managed_ports)" "$info")")
    echo "$state"
    [[ "$state" == "ok" ]]
}

resolve_conf() {
    local instance="$1" conf
    if [[ "$instance" =~ ^[0-9]+$ ]]; then
        while read -r conf; do
            [[ "$(conf_get "$conf" port)" == "$instance" ]] && { echo "$conf"; return 0; }
        done < <(list_confs)
    else
        conf="$CONF_DIR/$instance.conf"
        if [[ -f "$conf" ]] && ! is_excluded "$(basename "$conf")"; then
            echo "$conf"; return 0
        fi
    fi
    return 1
}

main() {
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
        # print the leading comment block (up to the first empty line)
        sed -n '2,/^$/p' "$0" | sed '$d; s/^# \{0,1\}//'
        exit 0
    fi
    if [[ $# -eq 0 || "$1" == "list" ]]; then
        cmd_list
        exit 0
    fi
    if [[ "$1" == "names" ]]; then
        while read -r conf; do basename "$conf" .conf; done < <(list_confs)
        exit 0
    fi

    local subcmd=""
    if [[ "$1" == "status" || "$1" == "shards" ]]; then
        subcmd="$1"; shift
        [[ $# -eq 1 ]] || { echo "usage: rcli $subcmd <instance>" >&2; exit 2; }
    fi

    local instance="$1"; shift
    local conf
    conf=$(resolve_conf "$instance") || {
        echo "rcli: instance not found: $instance (try 'rcli list')" >&2
        exit 1
    }
    [[ -r "$conf" ]] || { echo "rcli: cannot read $conf (need sudo?)" >&2; exit 1; }
    [[ -n "$(conf_get "$conf" port)" ]] || { echo "rcli: no 'port' directive in $conf" >&2; exit 1; }

    case "$subcmd" in
        status) cmd_status "$conf" && exit 0 || exit 1 ;;
        shards) cmd_shards "$conf" && exit 0 || exit 1 ;;
    esac

    # Without a command redis-cli reads commands from stdin when stdout is not
    # a tty, which looks like a hang in "rcli name | grep ...". Default to "info".
    if [[ $# -eq 0 && ! -t 1 && -t 0 ]]; then
        set -- info
    fi

    run_cli "$conf" "$@"
}

main "$@"
